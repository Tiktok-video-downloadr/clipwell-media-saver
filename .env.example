# --- Core ---
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage paths (swap for object storage in production) ---
UPLOAD_STAGING_DIR=/tmp/media-platform/uploads
DIRECT_URL_STAGING_DIR=/tmp/media-platform/direct-url
OAUTH_STAGING_DIR=/tmp/media-platform/oauth
PROCESSED_OUTPUT_DIR=/tmp/media-platform/output
DELIVERY_DIR=/tmp/media-platform/delivery
TEMP_STORAGE_TTL_SECONDS=1800

# --- Security ---
# REQUIRED in production — signs download URLs. Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=replace-with-a-real-random-secret

# Gates /admin. Format "username:password". Leave unset to block /admin entirely.
ADMIN_BASIC_AUTH=

# Optional bearer tokens for internal-only endpoints.
METRICS_TOKEN=
CRON_TOKEN=

# --- Worker ---
WORKER_CONCURRENCY=4

# --- OAuth: only fill in the platforms you've actually registered apps for.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
